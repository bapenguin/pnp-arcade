        PRINT "you moved to the right"
        SLEEP 3
        GOTO 30
X:
        IF TIME = 9 THEN GOSUB castle:
        PRINT "AAAAAAAAAAAAAAAAAAH!!!"
        PRINT "oops wrong move"
 PLAY death$
 SLEEP 5
        GOTO 10
