   IF move$ = "Q" THEN GOSUB FINI
   GOTO 10
   F = 2
20
   GOTO 10
2
30 CLS
PRINT "Jimmy enters a cave"
   PRINT "press X to go down"
   PRINT "press Y to go back"
    INPUT move$
    IF move$ = "X" THEN GOSUB X
    IF move$ = "Y" THEN GOTO 10
