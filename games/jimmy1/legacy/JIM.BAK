BEGIN:
CLS
   PRINT "JIMMY ENTERS THE HALL PRESS"
   PRINT "x to go left"
   PRINT "y to go right"
   PRINT "Press Q to Quit"
IF F = 1 THEN GOTO 1
IF F = 2 THEN GOTO 2
1 INPUT move$

   IF move$ = "X" THEN GOSUB LEFT
