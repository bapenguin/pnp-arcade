town2:
CLS
PRINT " Jimmy is in the town of Resset "
PRINT " press 1 to talk"
PRINT " press 2 to find a magician"
PRINT " press 3 to go to the bar"
PRINT " press 4 to take a ferry accros the river"
INPUT town$
IF town$ = "1" THEN GOSUB girl:
IF town$ = "2" THEN GOSUB magic:
IF town$ = "3" THEN GOSUB bar2:
IF town$ = "4" THEN GOSUB ferry:
SLEEP

girl:
CLS
IF TIME = 12 THEN GOSUB nobody:
IF charm = 1 THEN GOSUB nobody:
PRINT " Jimmy comes across a good looking girl"
PRINT "press 1 to talk"
PRINT "press 2 to leave her to be"
INPUT girl$
IF girl$ = "1" THEN GOSUB MENU65:
IF girl$ = "2" THEN GOTO town2:
SLEEP

nobody:
PRINT " THERE IS NOBODY AROUND!!"

MENU65:
CLS
IF charm = 1 THEN GOSUB hel:
PRINT "Hello"
hel:
PRINT "The girl does not respond"
PRINT "press 1 to say your pretty"
PRINT "press 2 to say what's your name"
PRINT "press 3 to say a poem"
 SLEEP
INPUT girl$
CLS
IF girl$ = "1" THEN PRINT "your pretty"
IF girl$ = "1" THEN charm = 1
IF girl$ = "2" THEN GOSUB Talkin:
IF girl$ = "3" THEN GOSUB POEM:
GOTO MENU65

POEM:
CLS
PRINT "Roses are uh yellow"
PRINT "violets are purple"
PRINT " Sugar is sour"
PRINT " and so are you"
CLS
SLEEP 15
PRINT "SMACKKKKKKKKKKKKKK!!!!"
PRINT "ouch says Jimmy"
SLEEP
GOTO POEM:

Talkin:
CLS
COLOR 4, 0, 0
PRINT "my name is Leia"
COLOR 7, 0, 0
PRINT "My name is Jimmy"
COLOR 4, 0, 0
PRINT " That's a nice name"
PRINT "Why Don't you come to my place"
PRINT "(y/N)"
INPUT yes$
IF yes$ = "y" THEN GOSUB alright:
IF yes$ = "n" THEN GOTO town2:

alright:
CLS
COLOR 7, 0, 0
PRINT " Jimmy goes back to Leia's place.  Neighbors said they heard some wierd"
PRINT " Noises but we know what happened!"
SLEEP
TIME = 12
GOTO town2:

magic:
IF TIME <> 12 THEN PRINT " no magic here"
IF TIME = 12 THEN
PRINT " Jimmy comes across a wandering wizard he say he will teach you a trick"
PRINT "for $250"
PRINT "(Y/N)"
INPUT trick$
IF trick$ = "y" THEN GOSUB trick:
IF trick$ = "n" THEN GOTO town2:
END IF
trick:
IF MONEY < 250 THEN PRINT "YOu don't have enough"
IF MONEY >= 250 THEN
END IF
PRINT " here is the trick"
CLS

PRINT " Jimmy learned how to make his oppenent go blind"
SLEEP
TIME = 13

bar2:
CLS
PRINT " Jimmy enters the bar and sits down.  Soon another man sits down next to"
PRINT " Jimmy and says You're Jimmy right.  Well I have something you'll need to defeat BOB"
PRINT " Jimmy says WHAT BOB is my friend.  The man say's no he is not just take the"
PRINT "ferry cross the mountains and take this. With that the man vanishes"
PRINT "Jimmy has a magic sword"
SLEEP
WEAPON = 5
TIME = 14
GOTO town2:

ferry:
CLS
PRINT " the ferry man say's the toll is 200 dollars"
PRINT " pay it (Y\N)"
INPUT ferry$
IF ferry$ = "y" THEN GOSUB mountains:
IF ferry$ = "n" THEN GOTO town2:

mountains:
IF TIME <> 14 THEN PRINT " I don't know you"
IF TIME <> 14 THEN GOTO town2:
IF TIME = 14 THEN
MONEY = MONEY - 250
PRINT " Here you are Jimmy at the mountains"
END IF
SLEEP
GOSUB m2:

m2:
CLS
PRINT " Jimmy enters the mountains and sees a temple"
PRINT "press 1 to go forword"
PRINT " press 2 to camp"
SLEEP
INPUT me$
IF me$ = "1" THEN GOSUB herewe:
IF me$ = "2" THEN GOSUB camp:

camp:
CLS
PRINT " Jimmy makes a big mistake and camps out in the wolves den"
PRINT " DOTEEEEEEEEEEEEEEEEEEEEE!!!!!!!!!!"
SLEEP
GOSUB FINI:

herewe:
CLS
PRINT "Jimmy goes to the temple and sees BOB standing outside"
COLOR 6, 0, 0
PRINT "So Jimmy you want to go home eh! well try to get past me to do it"
COLOR 7, 0, 0
PRINT "ALLLLRIGGHTY- then"
PRINT " press 1 to lunge at BOB with your sword"
PRINT " press 2 to run"
INPUT BOB$
IF BOB$ = "1" THEN GOSUB fall:
IF BOB$ = "2" THEN GOSUB uhoh:

fall:
CLS
PRINT " Jimmy lunges at BOB but BOB disapears.  Jimmy fell down"
PRINT " press 1 to try again"
PRINT " press 2 to use magic"
INPUT more$
IF more$ = "1" THEN GOSUB yes:
IF more$ = "2" THEN GOSUB uhoh:

uhoh:
CLS
PRINT " BOB kills Jimmy with lightning bolt magic"
SLEEP
GOSUB FINI:

yes:
CLS
PRINT " Jimmy lunges at BOB but this time knowing wher BOB will disapear to"
PRINT " He strikes BOB in his stomach"
PRINT " press  1 to finish him"
PRINT " press  2 to use magic"
INPUT final$
IF final$ = "1" THEN GOTO uhoh:
IF final$ = "2" THEN GOSUB deathi:

deathi:
CLS
PRINT " Jimmy use his magic and......"

PRINT " makes BOB go blind"
PRINT " Jimmy takes his magic sword and plunges it into BOB's heart"
PRINT " YOU DID IT"
PRINT " Hold on there's more left"
SLEEP
star$ = "mB t140 o4 l2 cf o5 l1c o4 l4 b-ag o5 l3 f l1 c o4 l4 b-ag o5 l3 f l1 c l4 b-ab- l1 g"
PLAY star$


ending:
TIME = 15
CLS
PRINT " by"
CLS
'
PRINT " NICK PULEO"
PRINT "                 AND  DAVID PAUL"
CLS
PRINT " LOOK FOR JIMMY 2!"
SLEEP 25
GOSUB FINI:





itemlist:
   CLS
   IF WEAPON = 0 THEN weapname$ = "Unarmed"
   IF WEAPON = 1 THEN weapname$ = "Knife"
   IF WEAPON = 2 THEN weapname$ = "Crossbow"
   IF WEAPON = 3 THEN weapname$ = "Spear"
   IF WEAPON = 4 THEN weapname$ = "Revolver"
   IF WEAPON = 5 THEN weapname$ = "Magic Sword"
   PRINT "Weapon:  "; weapname$
   IF armor = 0 THEN Armname$ = "None"
   IF armor = 1 THEN Armname$ = "Leather"
   IF armor = 2 THEN Armname$ = "Chain Mail"
   IF armor = 3 THEN Armname$ = "Magical"
   PRINT "Armor:  "; Armname$
   IF shield = 0 THEN shldname$ = "None"
   IF shield = 1 THEN shldname$ = "Wooden"
   IF shield = 2 THEN shldname$ = "Iron"
   IF shield = 3 THEN shldname$ = "Magical"
   PRINT "Shield:  "; shldname$
   PRINT "Money:  $"; MONEY
   PRINT "Points: $"; TIME
   PRINT "Items:"
   IF rope$ = "TRUE" THEN PRINT "Rope"
   IF chainsaw$ = "TRUE" THEN PRINT "Chainsaw"
   IF woodpcs$ = "TRUE" THEN PRINT "500 pieces of wood"
   PRINT "Press ENTER..."
   SLEEP
   RETURN

FINI:
CLS
IF TIME = 15 THEN PRINT " CONGRATULATIONS"
INPUT w$
END
RETURN

    
 

